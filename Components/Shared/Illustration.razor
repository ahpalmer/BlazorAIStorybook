@* Inline SVG motifs. Colors come from the CSS tokens so everything retunes with the palette. *@

@switch (Name)
{
    case "crest":
        <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <circle cx="110" cy="110" r="86" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5" />
            <circle cx="110" cy="110" r="76" fill="none" stroke="currentColor" stroke-width="6" opacity="0.9" />
            <path d="M110 44 L124 88 L170 88 L133 114 L147 158 L110 131 L73 158 L87 114 L50 88 L96 88 Z"
                  fill="currentColor" opacity="0.92" />
            <circle cx="110" cy="30" r="6" fill="currentColor" />
            <circle cx="190" cy="110" r="4" fill="currentColor" opacity="0.7" />
            <circle cx="30" cy="110" r="4" fill="currentColor" opacity="0.7" />
            <circle cx="110" cy="190" r="4" fill="currentColor" opacity="0.7" />
        </svg>
        break;

    case "hero":
        <svg viewBox="0 0 240 200" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <ellipse cx="120" cy="178" rx="58" ry="9" fill="var(--ink)" opacity="0.12" />
            <path d="M120 84 C152 84 168 114 168 142 L168 170 L72 170 L72 142 C72 114 88 84 120 84 Z"
                  fill="var(--indigo)" />
            <circle cx="120" cy="62" r="32" fill="var(--orange)" />
            <path d="M88 58 C92 30 148 30 152 58 C140 46 100 46 88 58 Z" fill="var(--magenta)" />
            <circle cx="109" cy="64" r="4" fill="var(--ink)" />
            <circle cx="131" cy="64" r="4" fill="var(--ink)" />
            <path d="M110 76 q10 8 20 0" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
            <path d="M62 128 l4 -12 l4 12 l12 4 l-12 4 l-4 12 l-4 -12 l-12 -4 Z" fill="var(--paper-crease)" />
            <path d="M186 52 l3 -9 l3 9 l9 3 l-9 3 l-3 9 l-3 -9 l-9 -3 Z" fill="var(--sky)" />
        </svg>
        break;

    case "menagerie":
        <svg viewBox="0 0 260 200" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <ellipse cx="130" cy="180" rx="96" ry="9" fill="var(--ink)" opacity="0.1" />
            <g fill="var(--indigo)">
                <ellipse cx="72" cy="132" rx="38" ry="30" />
                <circle cx="46" cy="106" r="20" />
                <path d="M32 92 l-4 -20 l18 10 Z" />
                <path d="M58 90 l6 -20 l12 16 Z" />
                <path d="M108 138 q26 -6 20 20" fill="none" stroke="var(--indigo)" stroke-width="6" stroke-linecap="round" />
            </g>
            <circle cx="40" cy="104" r="3" fill="var(--paper)" />
            <g fill="var(--magenta)">
                <ellipse cx="182" cy="140" rx="34" ry="26" />
                <circle cx="212" cy="112" r="19" />
                <path d="M200 96 q12 -22 26 -6 q-8 2 -12 12 Z" />
            </g>
            <circle cx="218" cy="110" r="3" fill="var(--paper)" />
            <g fill="var(--orange)">
                <ellipse cx="130" cy="66" rx="22" ry="16" />
                <path d="M148 60 l24 -12 l-10 22 Z" />
                <circle cx="116" cy="60" r="10" />
            </g>
            <circle cx="113" cy="58" r="2.5" fill="var(--paper)" />
        </svg>
        break;

    case "quill":
        <svg viewBox="0 0 220 200" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <path d="M40 172 q28 6 56 0" stroke="var(--ink)" stroke-width="3" fill="none" opacity="0.25" stroke-linecap="round" />
            <path d="M62 168 q-8 -34 8 -60 q22 8 22 40 q0 16 -12 22 Z" fill="var(--indigo)" opacity="0.85" />
            <path d="M74 172 C96 120 132 70 186 32 C168 96 132 146 86 176 Z" fill="var(--coral)" />
            <path d="M92 158 C120 118 150 82 178 52" fill="none" stroke="var(--paper)" stroke-width="3" opacity="0.7" />
            <path d="M104 152 l24 8 M118 132 l24 8 M134 110 l22 8" stroke="var(--paper)" stroke-width="2.5" opacity="0.5" stroke-linecap="round" />
            <circle cx="150" cy="168" r="7" fill="var(--magenta)" opacity="0.8" />
            <circle cx="172" cy="158" r="4" fill="var(--magenta)" opacity="0.55" />
        </svg>
        break;

    case "forest":
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <rect x="54" y="72" width="12" height="30" rx="3" fill="var(--ink-soft)" />
            <path d="M60 14 L90 56 L30 56 Z" fill="var(--leaf-green)" />
            <path d="M60 36 L94 84 L26 84 Z" fill="var(--leaf-green)" opacity="0.85" />
            <circle cx="26" cy="96" r="8" fill="var(--orange)" opacity="0.8" />
            <circle cx="96" cy="98" r="6" fill="var(--magenta)" opacity="0.7" />
        </svg>
        break;

    case "space":
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <circle cx="60" cy="58" r="26" fill="var(--indigo)" />
            <ellipse cx="60" cy="58" rx="46" ry="13" fill="none" stroke="var(--orange)" stroke-width="5"
                     transform="rotate(-20 60 58)" />
            <circle cx="24" cy="24" r="4" fill="var(--paper-crease)" />
            <circle cx="100" cy="30" r="3" fill="var(--paper-crease)" />
            <circle cx="94" cy="96" r="4" fill="var(--paper-crease)" />
            <path d="M22 96 l4 -10 l4 10 l10 4 l-10 4 l-4 10 l-4 -10 l-10 -4 Z" fill="var(--coral)" />
        </svg>
        break;

    case "castle":
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <rect x="26" y="52" width="68" height="52" fill="var(--indigo)" opacity="0.9" />
            <rect x="16" y="40" width="18" height="64" fill="var(--indigo)" />
            <rect x="86" y="40" width="18" height="64" fill="var(--indigo)" />
            <path d="M16 40 L25 22 L34 40 Z" fill="var(--coral)" />
            <path d="M86 40 L95 22 L104 40 Z" fill="var(--coral)" />
            <path d="M26 52 L60 28 L94 52 Z" fill="var(--magenta)" />
            <path d="M50 104 v-22 a10 10 0 0 1 20 0 v22 Z" fill="var(--orange)" />
            <circle cx="60" cy="60" r="5" fill="var(--paper)" opacity="0.85" />
        </svg>
        break;

    case "ocean":
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <circle cx="88" cy="30" r="12" fill="var(--orange)" opacity="0.85" />
            <path d="M0 62 q20 -14 40 0 t40 0 t40 0 v46 H0 Z" fill="var(--sky)" />
            <path d="M0 80 q20 -14 40 0 t40 0 t40 0 v28 H0 Z" fill="var(--indigo)" opacity="0.75" />
            <path d="M42 62 L60 34 L78 62 Z" fill="var(--paper)" />
            <path d="M60 34 v28" stroke="var(--ink-soft)" stroke-width="2.5" />
            <path d="M34 66 h52 l-8 10 H42 Z" fill="var(--coral)" />
        </svg>
        break;

    case "flourish":
        <svg viewBox="0 0 200 24" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
            <path d="M4 12 q34 -14 56 0 q22 14 40 0 q18 -14 40 0 q22 14 56 0" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.55" />
            <circle cx="100" cy="12" r="3.5" fill="currentColor" opacity="0.7" />
        </svg>
        break;
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
}
