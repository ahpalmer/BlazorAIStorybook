<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Caveat:wght@500;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css?v=@Build" />
    <link rel="stylesheet" href="BlazorAIStorybook.styles.css?v=@Build" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="app.js?v=@Build"></script>
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Changes every build, so a rebuilt CSS bundle is never served from a stale browser cache.
    private static readonly string Build =
        typeof(Program).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];
}
